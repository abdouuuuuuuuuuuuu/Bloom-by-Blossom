{
  "name": "bloom",
  "private": true,
  "version": "1.2.1",
  "description": "Bloom - monthly sales activity for Blossom",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test \"scripts/*.test.mjs\"",
    "desktop": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.10.2",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.1",
    "tailwindcss": "^4.3.5",
    "vite": "^6.4.6"
  },
  "main": "electron/main.cjs",
  "author": "Blossom",
  "build": {
    "appId": "com.blossom.bloom",
    "productName": "Bloom",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "!dist/__fixture.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bloom",
      "artifactName": "Bloom-Setup-${version}.exe"
    },
    "publish": null
  }
}
